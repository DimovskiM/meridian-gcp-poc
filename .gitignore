# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
# Per-region/environment tfvars under infra/envs/ hold no secrets (project
# id, region, CIDRs) and are committed deliberately — see infra/envs/.
!infra/envs/*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Secrets / keys
*-key.json
sa-key*.json
credentials*.json
*.pem
*.key
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
